<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>br.com.labcontrol</groupId>
    <artifactId>labcontrol-web</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>LabControl Web</name>
    <description>
        LabControl — Etapa 9 do Projeto Integrador (Senac). Sistema de
        gestão de equipamentos de laboratório reimplementado como
        aplicação web Spring MVC/REST com persistência JPA/MySQL,
        integrando as regras de negócio da Etapa 6/7 e o front-end da
        Etapa 8 (adaptado para Thymeleaf).
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.3.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>3.3.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <version>3.3.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>3.3.4</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Empacotamento WAR para Tomcat externo (mesmo padrão usado no
             projeto Casa Cultural Cinema): o servidor embarcado só é
             usado durante o desenvolvimento (mvn spring-boot:run); no
             deploy real, o Tomcat do NetBeans/servidor externo assume. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <version>3.3.4</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.3.4</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>labcontrol</finalName>
        <plugins>
            <!-- IMPORTANTE: o goal "repackage" deste plugin fica
                 DESABILITADO por padrão aqui (skip=true). Motivo: por
                 padrão, ele reempacotaria o WAR embutindo um Tomcat
                 inteiro dentro de BOOT-INF/, formato que só o próprio
                 Spring Boot sabe iniciar — um Tomcat EXTERNO (como o
                 configurado no NetBeans, em Tools > Servers) não
                 consegue interpretar esse WAR "gordo" como uma webapp
                 comum, e o deploy simplesmente não acontece.

                 Com skip=true, `mvn package` gera um WAR tradicional
                 (fino, sem o Tomcat embutido), que o NetBeans consegue
                 implantar normalmente no Tomcat externo pelo botão Run.

                 Para rodar com o Tomcat embarcado do Spring Boot em vez
                 do NetBeans (atalho de desenvolvimento, sem precisar de
                 servidor configurado), use o goal spring-boot:run
                 diretamente — ele ignora esta configuração de skip e
                 sempre roda com o classpath completo. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.3.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
